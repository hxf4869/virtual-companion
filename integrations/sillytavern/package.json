{
  "name": "vc-sillytavern-integration",
  "version": "0.1.0",
  "private": true,
  "description": "V2 SillyTavern 宿主集成：开发入口脚本、确定性补丁、C1 备份包装、验收脚本与离线测试（自有代码按 AGPL-3.0 标注，见 README）",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "status": "node scripts/status.mjs",
    "assemble-managed": "node scripts/assemble-managed.mjs",
    "start-managed": "node scripts/start-managed.mjs",
    "stop-managed": "node scripts/stop-managed.mjs",
    "status-managed": "node scripts/status-managed.mjs",
    "pretest": "npm run build:desktop",
    "test": "node --test \"tests/*.test.mjs\"",
    "accept": "node scripts/accept.mjs",
    "protection-report": "node scripts/protection-report.mjs",
    "check:desktop": "tsc --project desktop-ui/tsconfig.json",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test:desktop": "vitest run --config desktop-ui/vitest.config.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@node-rs/jieba": "2.0.1",
    "crc-32": "1.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sqlite-vec": "0.1.7-alpha.2"
  }
}
