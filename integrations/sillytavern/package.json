{
  "name": "vc-sillytavern-integration",
  "version": "0.1.0",
  "private": true,
  "description": "V2 SillyTavern 宿主集成：开发入口脚本、确定性补丁、C1 备份包装、验收脚本与离线测试（自有代码按 AGPL-3.0 标注，见 README）",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "status": "node scripts/status.mjs",
    "assemble-managed": "node scripts/assemble-managed.mjs",
    "start-managed": "node scripts/start-managed.mjs",
    "stop-managed": "node scripts/stop-managed.mjs",
    "status-managed": "node scripts/status-managed.mjs",
    "pretest": "npm run build:desktop",
    "test": "node --test \"tests/*.test.mjs\" && node --test tests/evaluation-meter.performance.mjs",
    "accept": "node scripts/accept.mjs",
    "protection-report": "node scripts/protection-report.mjs",
    "check:desktop": "tsc --project desktop-ui/tsconfig.json",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test:desktop": "vitest run --config desktop-ui/vitest.config.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "es-module-lexer": "3.0.4",
    "happy-dom": "21.0.4",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@emoji-mart/data": "1.2.1",
    "@ionic/react": "9.0.10",
    "@ionic/react-router": "9.0.10",
    "@monaco-editor/react": "4.7.0",
    "@node-rs/jieba": "2.0.1",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "cmdk": "1.1.1",
    "crc-32": "1.2.2",
    "emoji-mart": "5.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "6.30.4",
    "react-router-dom": "6.30.4",
    "sqlite-vec": "0.1.7-alpha.2",
    "wavesurfer.js": "8.0.5",
    "yet-another-react-lightbox": "3.33.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "overrides": {
    "cmdk": {
      "@radix-ui/react-dialog": "npm:@radix-ui/react-primitive@2.2.0"
    }
  }
}
