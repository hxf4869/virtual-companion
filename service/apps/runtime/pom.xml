<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.virtualcompanion</groupId>
        <artifactId>virtual-companion-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>virtual-companion-runtime</artifactId>
    <name>Virtual Companion :: Apps :: Runtime</name>

    <dependencies>
        <dependency>
            <groupId>com.virtualcompanion</groupId>
            <artifactId>virtual-companion-catalog</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.virtualcompanion</groupId>
            <artifactId>virtual-companion-persistence</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Model runtime orchestration, authorization guard, routing and quota. -->
        <dependency>
            <groupId>com.virtualcompanion</groupId>
            <artifactId>virtual-companion-modelruntime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- PERSONA-WIRE: provider-neutral persona skeleton + interaction modes
             (gentle-listener) injected into the external generation context. -->
        <dependency>
            <groupId>com.virtualcompanion</groupId>
            <artifactId>virtual-companion-conversation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Fail-closed safety gate consumed by the live invocation path. -->
        <dependency>
            <groupId>com.virtualcompanion</groupId>
            <artifactId>virtual-companion-safety</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Approved live model suppliers: OpenAI Chat Completions + Anthropic Messages. -->
        <dependency>
            <groupId>com.virtualcompanion</groupId>
            <artifactId>virtual-companion-model-openai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.virtualcompanion</groupId>
            <artifactId>virtual-companion-model-anthropic</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Jackson JSON parser for the realtime SSE controller to split the
             resume_stream durable-events envelope into individual SSE events
             (TASK-0184). jackson-databind is otherwise runtime-only here
             (transitively via jjwt-jackson); the HTTP layer parses event JSON at
             compile time, so the dependency is promoted to compile. Version stays
             managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- In-app Flyway with an explicit migrator datasource (VC_MIGRATOR_DB_*),
             fully separate from the runtime datasource (VC_DB_*). This starter
             activates Boot 4.1.0's FlywayAutoConfiguration (spring-boot-flyway
             module); the flyway-core version stays managed by the parent. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <!-- Mature JWT library (jjwt, Apache-2.0). The API jar is compile-time;
             impl/jackson are runtime only. Password hashing uses Spring Security's
             BCryptPasswordEncoder (spring-security-crypto, already present), so no
             self-written crypto primitive is introduced. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
