<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.virtualcompanion</groupId>
        <artifactId>virtual-companion-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>virtual-companion-persistence</artifactId>
    <name>Virtual Companion :: Platform :: Persistence</name>
    <description>PostgreSQL 18 + pgvector persistence baseline: Flyway migrations,
        composite ownership, FORCE RLS, minimal-privilege roles and JDBC skeletons.</description>

    <dependencies>
        <!-- Domain ports and value types implemented by the JDBC skeletons. -->
        <dependency>
            <groupId>com.virtualcompanion</groupId>
            <artifactId>virtual-companion-modelruntime</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Flyway runs the db/migration scripts on startup; versions are
             managed by spring-boot-starter-parent. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
