# DEPLOY edge: TLS termination (Caddy automatic HTTPS — ACME for public
# domains, local CA for localhost) and the Go API slice.
# The old Vue H5 static site is no longer served from this edge.

{
	# LAN/IP dogfood (ADR-0006): browsers never send SNI for plain IP
	# addresses (RFC 6066), so https://<LAN-IP> would fail the TLS handshake
	# without a fallback name. Point it at the single served VC_DOMAIN.
	default_sni {$VC_DOMAIN}
}

{$VC_DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	# API + realtime SSE (flush immediately; SSE must not buffer).
	handle /api/* {
		reverse_proxy runtime:8080 {
			header_up X-Forwarded-For {http.request.remote.host}
			flush_interval -1
		}
	}

	# Health probes used by the Go Runtime console — never the wider actuator
	# surface (for example metrics/prometheus).
	handle /actuator/health* {
		reverse_proxy runtime:8080 {
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}

}
