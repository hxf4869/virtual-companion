# DEPLOY edge: TLS termination (Caddy automatic HTTPS — ACME for public
# domains, local CA for localhost), H5 static bundle, and the API slice.
# Cache policy completes H5-HARDEN (§21.7): hashed assets immutable,
# the SPA shell no-cache, security headers everywhere.

{$VC_DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	# API + realtime SSE (flush immediately; SSE must not buffer).
	handle /api/* {
		reverse_proxy runtime:8080 {
			flush_interval -1
		}
	}

	# Health probe only — never the wider actuator surface.
	handle /actuator/health {
		reverse_proxy runtime:8080
	}

	# Hashed build assets: cache forever (filename changes on change).
	handle_path /static/* {
		root * /srv/h5/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA shell + assets fallback: revalidate always.
	handle {
		root * /srv/h5
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
