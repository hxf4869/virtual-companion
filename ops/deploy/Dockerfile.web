# DEPLOY edge image: Caddy + the built H5 bundle + the edge Caddyfile.
# Build AFTER `pnpm --dir frontend build` so frontend/dist exists.

# Rebuild the same Caddy v2.11.7 (official standard modules, no plugins) from
# source so the pinned Go toolchain and golang.org/x/net v0.60.0 apply; the
# resulting binary replaces the one shipped inside the runtime base image.
FROM golang:1.26.10-alpine3.23@sha256:0525c952defebc693cdaf62cdf43afa32be5a7f377e99260642ea19c240c708e AS caddy-build
WORKDIR /src
COPY ops/deploy/caddy-build/main.go ops/deploy/caddy-build/go.mod ops/deploy/caddy-build/go.sum ./
RUN mkdir -p /out \
    && CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags="-s -w" -tags=nobadger,nomysql,nopgx -o /out/caddy .

FROM caddy:2.11.7@sha256:3095ad245c353e3bdb27a38f22a095c1cfa9e295ab21c0214c3e72b0e2960525
COPY --from=caddy-build /out/caddy /usr/bin/caddy
# COPY drops the file capability the base image sets on /usr/bin/caddy;
# restore exactly that capability with the base image's own setcap.
RUN setcap cap_net_bind_service=+ep /usr/bin/caddy
COPY ops/deploy/Caddyfile /etc/caddy/Caddyfile
COPY frontend/dist/build/h5/ /srv/h5
