# Go companiond 部署环境变量。复制为 .env.local（本机）或 .env（服务器），
# 真实值只保存在私有部署配置中，不提交仓库。

# H5 与 API 必须同源；可填写域名或受控局域网 IP。
VC_DOMAIN=example.example
VC_HTTP_PORT=80
VC_HTTPS_PORT=443

# PostgreSQL：迁移账号与运行账号必须使用不同的 URL-safe 随机密码。
# 推荐：openssl rand -hex 32
VC_MIGRATOR_DB_PASSWORD=change-me-migrator-strong-random
VC_RUNTIME_DB_PASSWORD=change-me-runtime-strong-random
VC_DB_MAX_CONNS=8
VC_DB_TX_TIMEOUT=5s

# 数据归属 HMAC 密钥（至少 32 字节）与 AES-256 静态加密密钥。
# 推荐分别生成：openssl rand -base64 32
VC_OWNER_BINDING_SECRET=
VC_CRYPTO_REST_KEY=
VC_CRYPTO_REST_KEY_ID=default
VC_CRYPTO_REST_KEY_VERSION=1
# 仅在轮换密钥时填写上一版本；平时留空。
VC_CRYPTO_PREVIOUS_REST_KEY=
VC_CRYPTO_PREVIOUS_REST_KEY_ID=
VC_CRYPTO_PREVIOUS_REST_KEY_VERSION=0

# 首次启动可选的管理员种子；已存在时 bootstrap 幂等跳过。
VC_ADMIN_SEED_USERNAME=
VC_ADMIN_SEED_PASSWORD=
VC_ADMIN_SEED_DISPLAY_NAME=管理员

# 模型供应商、模型和路由顺序在管理员页面配置，并加密存入 PostgreSQL。
# 仅本机联调 loopback HTTP provider 时才设 true；生产保持 false。
VC_PROVIDER_ALLOW_LOOPBACK_HTTP=false
VC_PROVIDER_CONNECT_TIMEOUT=10s
VC_PROVIDER_FIRST_TOKEN_TIMEOUT=60s
VC_PROVIDER_TOTAL_TIMEOUT=240s
VC_PROVIDER_MAX_RESPONSE_BYTES=262144

# 每轮冻结的资源预算。
VC_BUDGET_MAX_INPUT_TOKENS=8000
VC_BUDGET_MAX_OUTPUT_TOKENS=2048
VC_BUDGET_MAX_RESPONSE_BYTES=262144
VC_BUDGET_CONNECT_TIMEOUT=10s
VC_BUDGET_FIRST_TOKEN_TIMEOUT=60s
VC_BUDGET_TOTAL_TIMEOUT=240s
VC_BUDGET_MAX_ATTEMPTS=2
VC_BUDGET_MAX_RESERVED_COST=0

# Opaque cookie 会话与 worker 并发。
VC_SESSION_TTL=168h
VC_SESSION_REAUTH_WINDOW=15m
VC_MAX_OUTSTANDING_TURNS=8
VC_MAX_CONCURRENT_TURNS=1
VC_QUEUE_TIMEOUT=5m
VC_JOB_CLAIM_LIMIT=8
VC_JOB_RECOVER_INTERVAL=5s
VC_SHUTDOWN_TIMEOUT=15s

# 私有 MinIO bucket；当前由 Compose 创建且不开放匿名访问。
VC_EXPORT_S3_ACCESS_KEY=change-me-minio-access-strong-random
VC_EXPORT_S3_SECRET_KEY=change-me-minio-secret-strong-random
VC_EXPORT_S3_BUCKET=vc-exports

VC_LOG_LEVEL=info
VC_VERSION=0.1.0
VC_COMMIT=
