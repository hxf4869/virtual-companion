# DEPLOY 部署环境变量（复制为 .env 后逐项填写；.env 不入库）
# 域名与 TLS
VC_DOMAIN=example.example
# 数据库（compose 内网；密码自定强随机）
VC_POSTGRES_PASSWORD=change-me-strong-random
# 生产 fail-closed 密钥（全部必填，32 字节 base64 = `openssl rand -base64 32`）
VC_JWT_SECRET=
VC_OWNER_BINDING_SECRET=
VC_CRYPTO_REST_KEY=
# 管理员种子（首启创建；留空则不种子）
VC_ADMIN_SEED_USERNAME=
VC_ADMIN_SEED_PASSWORD=
# 告警 Webhook（可选；留空禁用发送）
VC_ALERT_WEBHOOK_URL=
# 数据保留清理（草案周期经 Owner/法务复核后才置 true）
VC_RETENTION_PURGE_ENABLED=false
# 单副本硬门禁（S0-33/§12.7）：Technical Alpha/Beta 固定 1；任何其他值会使
# runtime 启动失败（含 --scale 与第二套 stack 指向同一数据库的误配置）
VC_RUNTIME_REPLICAS=1
# 构建标识（可选，git rev-parse --short HEAD）
VC_COMMIT=
