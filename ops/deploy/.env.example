# DEPLOY 部署环境变量（复制为 .env 后逐项填写；.env 不入库）
# 域名与 TLS。H5 与 API 必须同源（Caddy 反代）；runtime 用
# https://$VC_DOMAIN 作为 Origin 白名单。不要填 * 或把 token 写 localStorage。
VC_DOMAIN=example.example
# 可选宿主端口；生产默认 80/443，本机并行演练可改为 18080/18443
VC_HTTP_PORT=80
VC_HTTPS_PORT=443
# 数据库（compose 内网；migrator/runtime 必须使用不同强随机密码）
VC_MIGRATOR_DB_PASSWORD=change-me-migrator-strong-random
VC_RUNTIME_DB_PASSWORD=change-me-runtime-strong-random
# 生产 fail-closed 密钥（全部必填，32 字节 base64 = `openssl rand -base64 32`）
VC_JWT_SECRET=
VC_OWNER_BINDING_SECRET=
VC_SHARED_RATE_LIMIT_ENABLED=true
VC_SHARED_RATE_LIMIT_SECRET=
VC_CRYPTO_REST_KEY=
# 管理员种子（首启创建；留空则不种子）
VC_ADMIN_SEED_USERNAME=
VC_ADMIN_SEED_PASSWORD=
# 告警通道（可选；留空禁用发送）。generic / feishu-custom-bot 使用
# WEBHOOK_URL + WEBHOOK_SECRET；feishu-app-bot 使用下方三项飞书配置。
VC_ALERT_WEBHOOK_URL=
VC_ALERT_WEBHOOK_PROVIDER=generic
VC_ALERT_WEBHOOK_SECRET=
VC_ALERT_WEBHOOK_ALLOWED_HOSTS=
VC_ALERT_FEISHU_APP_ID=
VC_ALERT_FEISHU_APP_SECRET=
VC_ALERT_FEISHU_CHAT_ID=
# 独立替补通道（可选，仅 generic signed webhook；不得复用主通道 Secret）
VC_ALERT_FALLBACK_WEBHOOK_URL=
VC_ALERT_FALLBACK_WEBHOOK_SECRET=
VC_ALERT_FALLBACK_WEBHOOK_ALLOWED_HOSTS=
# 真实 generation provider 总开关默认关闭；非 FAKE 部署必须配置正月度上限和 V105 price
VC_MODEL_PROVIDERS_ENABLED=false
VC_MODEL_BUDGET_MONTHLY_USD=0
VC_MODEL_BUDGET_RESERVATION_OUTPUT_TOKENS=8192
# 真实 moderation（默认关闭；供应商/地区/隐私/费用批准前不得启用）
VC_MODERATION_ENABLED=false
VC_MODERATION_PROVIDER_REF=
VC_MODERATION_BASE_URL=
VC_MODERATION_MODEL=
VC_MODERATION_MODEL_VERSION=
VC_MODERATION_MIN_CLEAN_CONFIDENCE=0.8
# 仅私有 .env/部署 Secret，绝不提交真实值
VC_MODERATION_API_KEY=
# 真实 embedding（默认关闭；双重同意、供应商/地区/费用批准前不得启用）
VC_EMBEDDING_ENABLED=false
VC_EMBEDDING_BASE_URL=
VC_EMBEDDING_MODEL=
VC_EMBEDDING_MODEL_VERSION=
VC_EMBEDDING_DIMENSION=64
VC_EMBEDDING_SPACE_ID=
# 迁移默认暂停；仅在目标 space/双重同意/费用均批准后置 true
VC_EMBEDDING_REEMBED_ENABLED=false
VC_EMBEDDING_SOURCE_SPACE_ID=alpha-hash-64
VC_EMBEDDING_REEMBED_BATCH_SIZE=16
# 仅私有 .env/部署 Secret，绝不提交真实值
VC_EMBEDDING_API_KEY=
# 真实成年核验（默认关闭；仅在供应商、PIA、地区与人工申诉流程批准后启用）
VC_AGE_PROVIDER_ENABLED=false
VC_AGE_PROVIDER_ENDPOINT=
VC_AGE_PROVIDER_REF=
VC_AGE_PROVIDER_VERSION=
VC_AGE_PROVIDER_ALLOWED_HOSTS=
# 仅私有 .env/部署 Secret；SUBJECT_SECRET 至少 32 字节，不得与 API key 复用
VC_AGE_PROVIDER_API_KEY=
VC_AGE_PROVIDER_SUBJECT_SECRET=
# 数据保留清理（草案周期经 Owner/法务复核后才置 true）
VC_RETENTION_PURGE_ENABLED=false
# 即使启用调度也默认仅估算；批准真实删除后才显式改为 false
VC_RETENTION_DRY_RUN=true
# S0-31 scheduler freshness（可选；默认 DAU/export 5 分钟、日任务 26 小时）
VC_JOB_DAU_STALE_SECONDS=300
VC_JOB_EXPORT_STALE_SECONDS=300
VC_JOB_AUTH_PURGE_STALE_SECONDS=93600
VC_JOB_RETENTION_STALE_SECONDS=93600
# 单副本硬门禁（S0-33/§12.7）：Technical Alpha/Beta 固定 1；任何其他值会使
# runtime 启动失败（含 --scale 与第二套 stack 指向同一数据库的误配置）
VC_RUNTIME_REPLICAS=1
# 构建标识（可选，git rev-parse --short HEAD）
VC_COMMIT=
