# G11 drill edge — maintenance window: every request answers 503 so no new
# admission can reach either runtime while the window is open. The local admin
# API stays on so `caddy reload` can push this config from the drill.
{
	auto_https off
}

:80 {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	handle /api/* {
		respond "vc maintenance window" 503
	}

	handle {
		respond "vc maintenance window" 503
	}
}
