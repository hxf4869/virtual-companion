{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidencePack",
  "type": "object",
  "required": ["taskId", "baseCommit", "headCommit", "contextFingerprint", "checks"],
  "properties": {
    "taskId": {"type": "string", "pattern": "^TASK-[0-9]+"},
    "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "headCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contextFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "verdict", "reviewedCommit", "evidencePath"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["PASS", "FAIL"]},
          "reviewedCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "evidencePath": {"type": "string", "minLength": 1}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status", "exitCode", "artifactHash", "reason"],
        "properties": {
          "command": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
          "exitCode": {"type": ["integer", "null"]},
          "artifactHash": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"]},
          "environment": {"type": "string", "minLength": 1},
          "verifiedCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    }
  }
}
