* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.zip binary

# Verbatim source snapshots preserve Markdown hard-break spaces.
docs/source/** whitespace=-trailing-space

# vendor 必须与上游逐字一致，不做空白检查
backend/vendor/** -whitespace
